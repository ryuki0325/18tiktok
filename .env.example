# 署名・ハッシュ用の秘密鍵（32文字以上のランダム文字列）。本番では必ず設定する。
AUTH_SECRET=
# 本番のPostgreSQL。未設定なら .data/pglite に組み込みPostgreSQL（PGlite）を作って使う。
DATABASE_URL=
# 初回起動時に作るスーパー管理者
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# デモ用の投稿者・動画（抽象プレースホルダー）を入れるか
SEED_DEMO=true
# メール送信（Resend）。未設定の間は確認リンクを画面に、再設定リンクはサーバーログにだけ出す
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
# メール内リンクに使うサイトのURL（例：https://glow.example.com）
APP_URL=
# 定期処理（/api/cron/link-health, /api/cron/purge）を外部のcronから呼ぶための鍵（16文字以上）
CRON_SECRET=
# ---- 写真の保存と配信 ----
# 動画は自社に保存せず、公式サンプル等の「埋め込みURL」で表示する（保存設定は不要）。
# 保存先が必要なのは「写真」だけ。本番（Render 等、ディスクが揮発する環境）では
# Bunny Storage に置くと再起動でも消えない。4つそろうと自動で使われる。
#   BUNNY_STORAGE_ZONE    ：Storage Zone 名
#   BUNNY_STORAGE_API_KEY ：その AccessKey（パスワード）
#   BUNNY_STORAGE_HOST    ：保存エンドポイント（地域により sg.storage.bunnycdn.com 等。既定 storage.bunnycdn.com）
#   BUNNY_STORAGE_CDN_HOST：配信に使う Pull Zone のホスト（xxxx.b-cdn.net）
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_CDN_HOST=
# 未設定の間は、このサーバー（既定 .data/media/photos）に保存（開発用）。
MEDIA_DIR=
# 写真投稿の1回あたりの枚数の上限（既定30）
UPLOAD_MAX_IMAGES=
# 写真1枚あたりの上限MB（端末で縮めた後。既定6）
UPLOAD_MAX_IMAGE_MB=
