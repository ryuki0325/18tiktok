# 署名・ハッシュ用の秘密鍵（32文字以上のランダム文字列）。本番では必ず設定する。
AUTH_SECRET=
# 本番のPostgreSQL。未設定なら .data/pglite に組み込みPostgreSQL（PGlite）を作って使う。
DATABASE_URL=
# 初回起動時に作るスーパー管理者
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# デモ用の投稿者・動画（抽象プレースホルダー）を入れるか
SEED_DEMO=true
# メール送信（Resend）。未設定の間は確認リンクを画面に、再設定リンクはサーバーログにだけ出す
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
# メール内リンクに使うサイトのURL（例：https://glow.example.com）
APP_URL=
# 定期処理（/api/cron/link-health, /api/cron/purge）を外部のcronから呼ぶための鍵（16文字以上）
CRON_SECRET=
