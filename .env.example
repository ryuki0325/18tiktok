# 署名・ハッシュ用の秘密鍵（32文字以上のランダム文字列）。本番では必ず設定する。
AUTH_SECRET=
# 本番のPostgreSQL。未設定なら .data/pglite に組み込みPostgreSQL（PGlite）を作って使う。
DATABASE_URL=
# 初回起動時に作るスーパー管理者
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# デモ用の投稿者・動画（抽象プレースホルダー）を入れるか
SEED_DEMO=true
# メール送信（Resend）。未設定の間は確認リンクを画面に、再設定リンクはサーバーログにだけ出す
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
# メール内リンクに使うサイトのURL（例：https://glow.example.com）
APP_URL=
# 定期処理（/api/cron/link-health, /api/cron/purge）を外部のcronから呼ぶための鍵（16文字以上）
CRON_SECRET=
# ---- 動画の保存と配信 ----
# 本番は Bunny Stream（保存・HLS変換・CDN配信をまとめて行う）を推奨。3つとも設定すると自動で使われる
#   BUNNY_STREAM_LIBRARY_ID：Stream → ライブラリ → API の「Video Library ID」
#   BUNNY_STREAM_API_KEY  ：同じ画面の「API Key」（ブラウザには渡さない）
#   BUNNY_STREAM_CDN_HOST ：同じ画面の「CDN Hostname」（例 vz-xxxxxxxx-xxx.b-cdn.net）
#   Webhook URL に https://<サイト>/api/v1/webhooks/bunny を設定すると変換完了がすぐ反映される
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
# local：このサーバーに保存し、ffmpeg があれば HLS（360p/540p/720p/1080p）に変換。ディスクが消えない環境向け
# 未指定：開発では local、本番では Bunny の設定がなければアップロード停止（「準備中」表示）
MEDIA_PROVIDER=
# local の保存先（既定 .data/media）と、前段にCDNを置く場合のURL（例 https://cdn.example.com）
MEDIA_DIR=
MEDIA_CDN_URL=
# アップロードの上限（MB、既定2048）と1チャンクの大きさ（KB、既定8192）
UPLOAD_MAX_MB=
UPLOAD_CHUNK_KB=
